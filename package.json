{
  "name": "protomend",
  "type": "module",
  "version": "0.3.3",
  "private": true,
  "packageManager": "pnpm@10.16.1",
  "description": "Protomend: modify HTTP request/response headers via declarativeNetRequest",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "release": "pnpm lint && pnpm compile && pnpm test && changelogen --release --push",
    "compile": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wxt build && bddgen && playwright test",
    "postinstall": "wxt prepare",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "@vueuse/integrations": "^14.4.0",
    "fuse.js": "^7.4.2",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@wxt-dev/module-vue": "^1.0.3",
    "changelogen": "^0.6.2",
    "eslint": "^10.8.0",
    "eslint-plugin-format": "^2.0.1",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.2.0",
    "playwright-bdd": "^9.2.0",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8",
    "wxt": "^0.21.2"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "simple-git-hooks"
    ],
    "overrides": {
      "esbuild": ">=0.28.1",
      "fx-runner>shell-quote": ">=1.8.4",
      "node-notifier>uuid": ">=11.1.1",
      "web-ext-run>tmp": ">=0.2.6"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
